{
  "uid": "canteen-overview",
  "title": "Canteen Service Overview",
  "tags": ["canteen", "sre"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Requests per second by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (route) (rate(canteen_http_requests_total[5m]))", "legendFormat": "{{route}}", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "Server errors per second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (route) (rate(canteen_http_requests_total{status_code=~\"5..\"}[5m]))", "legendFormat": "{{route}}", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "API request latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(canteen_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Requests in flight",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (method) (canteen_http_requests_in_flight)", "legendFormat": "{{method}}", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "Recent container logs",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{job=\"docker\"} |= \"http_request_complete\"", "refId": "A" }]
    }
  ],
  "annotations": { "list": [] },
  "links": []
}
